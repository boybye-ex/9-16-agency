# Meta Ad Library API
# Obtain after identity verification at facebook.com/ID
# Then create app at developers.facebook.com
META_ACCESS_TOKEN=your_meta_access_token_here

# Telegram Bot
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal or group chat ID
TELEGRAM_CHAT_ID=your_chat_id_here

# OpenAI
# Get from platform.openai.com
OPENAI_API_KEY=sk-your_openai_api_key_here

# Google AI (for Google Flow)
# Requires Google AI subscription (Plus/Pro/Ultra)
# Get from aistudio.google.com
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# SendGrid
# Get from sendgrid.com
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=outreach@916.agency

# Optional: Hunter.io for email discovery
HUNTER_API_KEY=your_hunter_api_key_here

# Logging
LOG_LEVEL=INFO

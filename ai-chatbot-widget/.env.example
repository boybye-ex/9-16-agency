# ===========================================
# AI PROVIDER - Choose ONE (all are FREE)
# ===========================================

# Which AI to use: 'groq' (recommended), 'gemini', or 'huggingface'
AI_PROVIDER=groq

# ----- OPTION 1: GROQ (Recommended - Fastest) -----
# Sign up FREE: https://console.groq.com
# Get API key: https://console.groq.com/keys
# Limits: 30 requests/min, 14,400/day (plenty for starting out)
GROQ_API_KEY=gsk_your_groq_key_here

# ----- OPTION 2: GOOGLE GEMINI -----
# Sign up FREE: https://aistudio.google.com
# Get API key: https://aistudio.google.com/app/apikey
# Limits: 1,500 requests/day on free tier
GEMINI_API_KEY=your_gemini_key_here

# ----- OPTION 3: HUGGING FACE -----
# Sign up FREE: https://huggingface.co/join
# Get API key: https://huggingface.co/settings/tokens
# Limits: Rate limited but free
HF_API_KEY=hf_your_token_here

# ===========================================
# SERVER CONFIG
# ===========================================
PORT=3000
